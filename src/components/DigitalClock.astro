<div class="digital-clock" id="digital-clock" aria-label="Current time">
	<span class="segments" aria-hidden="true">88:88</span>
	<span class="time" id="digital-clock-time">--:--</span>
	<span class="ampm" id="digital-clock-ampm">--</span>
</div>

<script>
	const timeEl = document.getElementById('digital-clock-time');
	const ampmEl = document.getElementById('digital-clock-ampm');
	const wrapperEl = document.getElementById('digital-clock');
	const mobileQuery = window.matchMedia('(max-width: 640px)');
	const BASE_FONT_SIZE = 16;

	function tick() {
		if (!timeEl || !ampmEl) return;
		const now = new Date();
		const pad = (n: number) => String(n).padStart(2, '0');
		const hours24 = now.getHours();
		const hours12 = hours24 % 12 || 12;
		timeEl.textContent = `${pad(hours12)}:${pad(now.getMinutes())}`;
		ampmEl.textContent = hours24 < 12 ? 'AM' : 'PM';
	}

	function fit() {
		if (!wrapperEl || !timeEl) return;
		if (!mobileQuery.matches) {
			wrapperEl.style.fontSize = '';
			return;
		}
		wrapperEl.style.fontSize = `${BASE_FONT_SIZE}px`;
		const naturalWidth = timeEl.getBoundingClientRect().width;
		const available = wrapperEl.clientWidth;
		const scale = naturalWidth > 0 ? available / naturalWidth : 1;
		wrapperEl.style.fontSize = `${BASE_FONT_SIZE * scale}px`;
	}

	tick();
	fit();
	setInterval(tick, 10000);
	window.addEventListener('resize', fit);
	mobileQuery.addEventListener('change', fit);
</script>

<style>
	.digital-clock {
		position: relative;
		display: inline-flex;
		align-items: flex-start;
		gap: 0.25rem;
		font-family: 'DSEG7 Classic', monospace;
		font-size: 2.5rem;
		line-height: 1;
		padding: 0.75rem 0.75rem;
		border-radius: 0.5rem;
		background: #0e1410;
	}
	.segments,
	.time {
		letter-spacing: 0.05em;
	}
	.segments {
		position: absolute;
		inset: 0.75rem 0.75rem;
		color: #1c2b20;
	}
	.time {
		position: relative;
		color: #3ef07a;
		text-shadow: 0 0 0.35em rgba(62, 240, 122, 0.75);
	}
	.ampm {
		font-family: system-ui, sans-serif;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		color: #3ef07a;
		text-shadow: 0 0 0.35em rgba(62, 240, 122, 0.75);
	}
	@media (max-width: 640px) {
		.digital-clock {
			display: block;
			width: 100%;
			padding: 0;
			border-radius: 0;
			opacity: 0.25;
		}
		.segments {
			inset: 0;
		}
		.ampm {
			display: none;
		}
	}
</style>
