---
// Ported from https://reactbits.dev/animations/magnet-lines
interface Props {
	rows?: number;
	columns?: number;
	containerSize?: string;
	lineColor?: string;
	lineWidth?: string;
	lineHeight?: string;
	baseAngle?: number;
	class?: string;
}

const {
	rows = 9,
	columns = 9,
	containerSize = '80vmin',
	lineColor = '#efefef',
	lineWidth = '1vmin',
	lineHeight = '6vmin',
	baseAngle = -10,
	class: className = '',
} = Astro.props;

const total = rows * columns;
const items = Array.from({ length: total });
---

<div
	class:list={['magnet-lines-container', className]}
	style={{
		gridTemplateColumns: `repeat(${columns}, 1fr)`,
		gridTemplateRows: `repeat(${rows}, 1fr)`,
		width: containerSize,
		height: containerSize,
	}}
>
	{
		items.map(() => (
			<span
				style={{
					'--rotate': `${baseAngle}deg`,
					backgroundColor: lineColor,
					width: lineWidth,
					height: lineHeight,
				}}
			/>
		))
	}
</div>

<script>
	function setupMagnetLines(container: HTMLElement) {
		const items = container.querySelectorAll<HTMLElement>('span');

		// Read all geometry first, then write all styles — interleaving the two
		// per item would force a synchronous reflow before every read.
		const applyPointer = (pointer: { x: number; y: number }) => {
			const centers = Array.from(items, (item) => {
				const rect = item.getBoundingClientRect();
				return { x: rect.x + rect.width / 2, y: rect.y + rect.height / 2 };
			});

			items.forEach((item, i) => {
				const center = centers[i];
				const b = pointer.x - center.x;
				const a = pointer.y - center.y;
				const c = Math.sqrt(a * a + b * b) || 1;
				const r = ((Math.acos(b / c) * 180) / Math.PI) * (pointer.y > center.y ? 1 : -1);

				item.style.setProperty('--rotate', `${r}deg`);
			});
		};

		// pointermove can fire far more often than the display refreshes, so
		// coalesce to at most one layout pass per animation frame.
		let rafId = 0;
		let latestPointer: { x: number; y: number } | null = null;
		const onPointerMove = (pointer: { x: number; y: number }) => {
			latestPointer = pointer;
			if (rafId) return;
			rafId = requestAnimationFrame(() => {
				rafId = 0;
				if (latestPointer) applyPointer(latestPointer);
			});
		};

		window.addEventListener('pointermove', onPointerMove);

		if (items.length) {
			const middleIndex = Math.floor(items.length / 2);
			const rect = items[middleIndex].getBoundingClientRect();
			applyPointer({ x: rect.x, y: rect.y });
		}
	}

	document.querySelectorAll<HTMLElement>('.magnet-lines-container').forEach(setupMagnetLines);
</script>

<style>
	.magnet-lines-container {
		display: grid;
		justify-items: center;
		align-items: center;
	}
	.magnet-lines-container span {
		display: block;
		transform-origin: center;
		will-change: transform;
		transform: rotate(var(--rotate));
	}
</style>
