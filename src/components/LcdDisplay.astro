---
interface Props {
	line1: string;
	line2?: string;
	as?: 'h1' | 'div';
	avatarSrc?: string;
	avatarAlt?: string;
}

const { line1, line2 = '', as: Tag = 'h1', avatarSrc, avatarAlt = '' } = Astro.props;

const COLS = 16;
const PIN_LABELS = ['VSS', 'VDD', 'V0', 'RS', 'RW', 'E', 'D0', 'D1', 'D2', 'D3', 'D4', 'D5', 'D6', 'D7', 'A', 'K'];

function toCells(text: string) {
	const chars = text.slice(0, COLS).split('');
	while (chars.length < COLS) chars.push(' ');
	return chars;
}

const row1 = toCells(line1);
const row2 = toCells(line2);
const singleLine = !line2;
---

<Tag class="lcd" aria-label={line2 ? `${line1} ${line2}` : line1}>
	<div class="pcb-scale">
	<div class="pcb">
		<span class="hole hole-tl"></span>
		<span class="hole hole-tr"></span>
		<span class="hole hole-bl"></span>
		<span class="hole hole-br"></span>
		<div class="lcd-bezel">
			<div class="lcd-screen" class:list={{ 'single-line': singleLine }} aria-hidden="true">
				<div class="lcd-glass"></div>
				<div class="screen-content">
					{avatarSrc && <canvas class="avatar-canvas" data-src={avatarSrc} data-alt={avatarAlt}></canvas>}
					<div class="text-rows">
						<div class="lcd-row">
							{row1.map((ch) => <span class="cell">{ch === ' ' ? ' ' : ch}</span>)}
						</div>
						{line2 && (
							<div class="lcd-row">
								{row2.map((ch) => <span class="cell">{ch === ' ' ? ' ' : ch}</span>)}
							</div>
						)}
					</div>
				</div>
			</div>
		</div>
		<div class="pin-header" aria-hidden="true">
			{PIN_LABELS.map((label) => (
				<div class="pin-slot">
					<span class="pin"></span>
					<span class="pin-label">{label}</span>
				</div>
			))}
		</div>
	</div>
	</div>
</Tag>

<script>
	const DITHER_GRID = 100;
	const CELL_PX = 1.6;
	const LUMA_THRESHOLD = 0.35;
	const EDGE_BAND = 0.15;
	const DOT_COLOR = '87, 244, 232';

	function ditherCanvas(canvas: HTMLCanvasElement) {
		const src = canvas.dataset.src;
		if (!src) return;

		const img = new Image();
		img.crossOrigin = 'anonymous';
		img.onload = () => {
			const sample = document.createElement('canvas');
			sample.width = DITHER_GRID;
			sample.height = DITHER_GRID;
			const sctx = sample.getContext('2d');
			if (!sctx) return;
			sctx.drawImage(img, 0, 0, DITHER_GRID, DITHER_GRID);
			const { data } = sctx.getImageData(0, 0, DITHER_GRID, DITHER_GRID);

			const lumas = new Float32Array(DITHER_GRID * DITHER_GRID);
			let minLuma = 1;
			let maxLuma = 0;
			for (let p = 0; p < lumas.length; p++) {
				const i = p * 4;
				const luma = (0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2]) / 255;
				lumas[p] = luma;
				if (luma < minLuma) minLuma = luma;
				if (luma > maxLuma) maxLuma = luma;
			}
			const range = maxLuma - minLuma || 1;

			canvas.width = DITHER_GRID * CELL_PX;
			canvas.height = DITHER_GRID * CELL_PX;
			const ctx = canvas.getContext('2d');
			if (!ctx) return;
			ctx.clearRect(0, 0, canvas.width, canvas.height);

			for (let y = 0; y < DITHER_GRID; y++) {
				for (let x = 0; x < DITHER_GRID; x++) {
					const p = y * DITHER_GRID + x;
					const a = data[p * 4 + 3];
					const normLuma = (lumas[p] - minLuma) / range;
					if (a <= 32) continue;
					const opacity = Math.min(1, Math.max(0, (normLuma - LUMA_THRESHOLD) / EDGE_BAND + 0.5));
					if (opacity <= 0) continue;

					const radius = CELL_PX * 0.42;
					const cx = x * CELL_PX + CELL_PX / 2;
					const cy = y * CELL_PX + CELL_PX / 2;
					ctx.beginPath();
					ctx.fillStyle = `rgba(${DOT_COLOR}, ${opacity * 0.95})`;
					ctx.shadowColor = `rgba(${DOT_COLOR}, ${opacity * 0.9})`;
					ctx.shadowBlur = radius * 1.4;
					ctx.arc(cx, cy, radius, 0, Math.PI * 2);
					ctx.fill();
				}
			}
		};
		img.src = src;
	}

	document.querySelectorAll<HTMLCanvasElement>('.avatar-canvas[data-src]').forEach(ditherCanvas);

	function setupFit(wrapper: HTMLElement) {
		const pcb = wrapper.querySelector<HTMLElement>('.pcb');
		const container = wrapper.parentElement;
		if (!pcb || !container) return;

		function fit() {
			wrapper.style.width = '';
			wrapper.style.height = '';
			pcb.style.transform = 'none';

			const naturalWidth = pcb.getBoundingClientRect().width;
			const naturalHeight = pcb.getBoundingClientRect().height;
			const available = container.clientWidth;
			const scale = Math.min(1, available / naturalWidth);

			if (scale < 1) {
				pcb.style.transformOrigin = 'top left';
				pcb.style.transform = `scale(${scale})`;
				wrapper.style.width = `${naturalWidth * scale}px`;
				wrapper.style.height = `${naturalHeight * scale}px`;
			}
		}

		// Re-fit whenever the PCB's natural size or the container's available
		// width changes for any reason (web font swap, viewport resize, mobile
		// browser toolbar collapse/expand) rather than guessing specific events.
		const ro = new ResizeObserver(fit);
		ro.observe(container);
		ro.observe(pcb);
		fit();
	}

	document.querySelectorAll<HTMLElement>('.pcb-scale').forEach(setupFit);
</script>

<style>
	.lcd {
		display: block;
		width: 100%;
		margin: 0;
		font-weight: normal;
		text-align: center;
	}
	.pcb-scale {
		display: inline-block;
		max-width: 100%;
	}
	.pcb {
		position: relative;
		display: inline-block;
		padding: 0.7rem 0.7rem 0.4rem;
		border-radius: 0.35rem;
		background:
			radial-gradient(circle at 15% 10%, rgba(255, 255, 255, 0.06), transparent 40%),
			linear-gradient(160deg, #121312, #333534);
		box-shadow:
			0 6px 16px rgba(0, 0, 0, 0.35),
			inset 0 1px 0 rgba(17, 17, 17, 0.08);
	}
	.hole {
		position: absolute;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: radial-gradient(circle at 35% 35%, #dcdcdc, #8a8a8a 65%, #5a5a5a);
		box-shadow: inset 0 0 0 2px #2a2b2a;
	}
	.hole-tl {
		top: 0.35rem;
		left: 0.35rem;
	}
	.hole-tr {
		top: 0.35rem;
		right: 0.35rem;
	}
	.hole-bl {
		bottom: 1.6rem;
		left: 0.35rem;
	}
	.hole-br {
		bottom: 1.6rem;
		right: 0.35rem;
	}
	.lcd-bezel {
		display: inline-block;
		padding: 0.7rem;
		border-radius: 0.4rem;
		background: linear-gradient(160deg, #4a4a4a, #1c1c1c);
		box-shadow:
			0 3px 8px rgba(0, 0, 0, 0.3),
			inset 0 1px 0 rgba(255, 255, 255, 0.1);
	}
	.lcd-screen {
		position: relative;
		display: inline-block;
		padding: 0.15rem 0.5rem;
		border-radius: 0.25rem;
		background: radial-gradient(120% 140% at 30% 0%, #14181b 0%, #08090a 65%, #030304 100%);
		box-shadow:
			inset 0 2px 8px rgba(0, 0, 0, 0.8),
			inset 0 -1px 0 rgba(255, 255, 255, 0.04);
		overflow: hidden;
	}
	.lcd-glass {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: linear-gradient(115deg, rgba(160, 210, 220, 0.1) 0%, rgba(160, 210, 220, 0.02) 25%, transparent 45%);
		mix-blend-mode: screen;
	}
	.screen-content {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}
	.avatar-canvas {
		display: block;
		aspect-ratio: 1;
		height: 100%;
		flex-shrink: 0;
		image-rendering: pixelated;
	}
	.text-rows {
		display: inline-grid;
		grid-auto-rows: clamp(1.4rem, 4.2vw, 2.6rem);
	}
	.single-line .text-rows {
		grid-auto-rows: clamp(2.8rem, 8.4vw, 5.2rem);
	}
	.lcd-row {
		position: relative;
		display: grid;
		grid-template-columns: repeat(16, 1fr);
	}
	.cell {
		font-family: 'Doto', monospace;
		font-weight: 800;
		font-size: clamp(1.4rem, 4.2vw, 2.6rem);
		line-height: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		color: rgba(87, 244, 232, 0.95);
		text-shadow:
			0 0 0.15em rgba(87, 244, 232, 0.5),
			0 0 0.5em rgba(87, 244, 232, 0.28),
			0 0 1em rgba(87, 244, 232, 0.15);
	}
	.single-line .cell {
		font-size: clamp(2.8rem, 8.4vw, 5.2rem);
	}
	.pin-header {
		display: flex;
		justify-content: center;
		gap: clamp(1px, 0.3vw, 3px);
		margin-top: 0.5rem;
		padding: 0 0.2rem;
	}
	.pin-slot {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.15rem;
	}
	.pin {
		position: relative;
		width: clamp(7px, 1.7vw, 12px);
		height: clamp(7px, 1.7vw, 12px);
		border-radius: 50%;
		background: radial-gradient(circle at 35% 35%, #f9e79a, #d9ab37 55%, #96731d 100%);
		box-shadow:
			0 0 1px rgba(0, 0, 0, 0.5),
			inset 0 0 1px rgba(255, 255, 255, 0.6);
	}
	.pin::after {
		content: '';
		position: absolute;
		inset: 30%;
		border-radius: 50%;
		background: #0a4a2c;
		box-shadow: inset 0 1px 1px rgba(0, 0, 0, 0.6);
	}
	.pin-label {
		font-family: system-ui, sans-serif;
		font-size: 0.4rem;
		letter-spacing: -0.02em;
		color: #cfe8d4;
		opacity: 0.55;
		writing-mode: vertical-rl;
		transform: rotate(180deg);
	}
</style>
