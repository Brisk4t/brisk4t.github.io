---
/**
 * "Links" panel listing useful links from a post's frontmatter.
 *
 * Usage (from a page):   <PostLinks links={post.data.links} />
 */
interface Props {
	links: { label: string; url: string }[];
}

const { links } = Astro.props;
const isExternal = (url: string) => /^https?:\/\//.test(url);
---

{
	links.length > 0 && (
		<aside class="post-links" aria-label="Links">
			<p class="post-links-title">Links</p>
			<ul>
				{links.map((link) => (
					<li>
						<a
							href={link.url}
							{...(isExternal(link.url) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
						>
							{link.label}
							{isExternal(link.url) && <span class="post-links-ext" aria-hidden="true">↗</span>}
						</a>
					</li>
				))}
			</ul>
		</aside>
	)
}

<style>
	.post-links {
		font-family: system-ui, sans-serif;
		font-size: 0.85rem;
		line-height: 1.4;
		margin: 0 0 1.5rem;
	}
	.post-links-title {
		margin: 0 0 0.5rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-size: 1rem;
		opacity: 0.6;
	}
	.post-links ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.post-links li {
		margin: 0.15rem 0;
	}
	.post-links a {
		display: block;
		padding: 0.15rem 0.25rem;
		text-decoration: none;
		color: inherit;
		opacity: 0.7;
		border-radius: 4px;
		overflow-wrap: anywhere;
	}
	.post-links a:hover {
		opacity: 1;
		background: color-mix(in srgb, currentColor 8%, transparent);
	}
	.post-links-ext {
		margin-left: 0.25rem;
		font-size: 0.75em;
		opacity: 0.6;
	}
</style>
