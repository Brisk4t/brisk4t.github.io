---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CwdBar from '../../components/CwdBar.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import Minimap from '../../components/Minimap.astro';
import PostLinks from '../../components/PostLinks.astro';
import { getCollection, render } from 'astro:content';
import 'remark-github-blockquote-alert/alert.css';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
	<CwdBar title={post.data.title} slug={post.id} headings={headings} />
	<div class="post-sidebar">
		<TableOfContents headings={headings} />
		<PostLinks links={post.data.links} />
	</div>
	<Minimap />
	<article>
		<h1>{post.data.title}</h1>
		<time datetime={post.data.pubDate.toISOString()}>
			{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
		</time>
		<Content />
	</article>
</BaseLayout>

<style>
	/* Wide screens with room beside the 960px article: dock the TOC + links to the left. */
	@media (min-width: 1500px) {
		.post-sidebar {
			position: fixed;
			top: 6rem;
			left: calc((100vw - 960px) / 2 - 16rem);
			width: 15rem;
			max-height: calc(100vh - 8rem);
			overflow-y: auto;
			padding-right: 0.75rem;
		}
	}
</style>
