---
import BaseLayout from '../layouts/BaseLayout.astro';
import AsciiText from '../components/AsciiText.astro';
import MagnetLines from '../components/MagnetLines.astro';
import Masonry from '../components/Masonry.astro';
import FlipTitle from '../components/FlipTitle.astro';
import DecryptedText from '../components/DecryptedText.astro';
import { getCollection } from 'astro:content';

const labs = (await getCollection('labs', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Home">
	<section>
		<div class="hero">
			<AsciiText text="Brisk4t" enableWaves={false} />
			<h3>All my crimes.</h3>
		</div>
	</section>

	<div class="split">
		<section class="col-blog">
			<div class="section-heading">
				<DecryptedText text="Dev Blog" href="/blog/" align="right" />
			</div>
			{(() => {
				const blogItems = posts.slice(0, 4).map((post) => ({
					src: post.data.heroImage!,
					alt: post.data.heroImageAlt,
					href: `/blog/${post.id}/`,
					label: post.data.title,
					title: post.data.title,
					description: post.data.description,
					longDescription: post.data.longDescription,
					date: post.data.pubDate,
				}));
				return <Masonry items={blogItems} titleFontSize="1.25rem" descriptionFontSize="1.125rem" descriptionLongFontSize="1rem" reverse />;
			})()}
		</section>

		<section class="col-scrapbook">
			<div class="section-heading">
				<FlipTitle text="Scrapbook" href="/lab/" randomizeStartColors />
			</div>
			{(() => {
				const masonryItems = labs
					.filter((lab) => lab.data.heroImage)
					.map((lab) => ({
						src: lab.data.heroImage!,
						alt: lab.data.heroImageAlt,
						href: lab.data.url ?? `/lab/${lab.data.slug}/`,
						target: lab.data.url ? '_blank' : undefined,
						label: lab.data.title,
						title: lab.data.title,
						description: lab.data.description,
						longDescription: lab.data.longDescription,
					}));
				return <Masonry items={masonryItems} />;
			})()}
		</section>
	</div>
</BaseLayout>

<style>
	:global(main) {
		max-width: none;
		margin: 0;
		padding: 2rem 3rem 3rem;
	}
	.page-bg {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		overflow: hidden;
		opacity: 0.16;
		pointer-events: none;
		z-index: -1;
	}
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.25rem;
		text-align: center;
	}
	.hero h3 {
		margin: 0;
	}
	.split {
		display: grid;
		grid-template-columns: 5fr 5fr;
		gap: 0 2.5rem;
		align-items: start;
		margin-top: 2rem;
	}
	.section-heading {
		display: flex;
		align-items: baseline;
		justify-content: flex-start;
		gap: 1rem;
	}
	.col-blog .section-heading {
		justify-content: flex-end;
	}
	.split :global(.masonry) {
		margin-top: 2rem;
	}
	@media (max-width: 800px) {
		.split {
			grid-template-columns: 1fr;
			gap: 3rem 0;
		}
		.section-heading,
		.col-blog .section-heading {
			justify-content: center;
		}
	}
</style>
