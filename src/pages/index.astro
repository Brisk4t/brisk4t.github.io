---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroTile from '../components/HeroTile.astro';
import LcdDisplay from '../components/LcdDisplay.astro';
import { getCollection } from 'astro:content';

const labs = (await getCollection('labs', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Home">
	<section>
		<div class="hero">
			<LcdDisplay line1="Brisk4t" avatarSrc="https://avatars.githubusercontent.com/u/31730769?s=200&v=4" avatarAlt="Brisk4t" />
		</div>
		<h3>All my crimes.</h3>
	</section>

	<section>
		<h2>Dev Blog</h2>
		<ul class="grid">
			{
				posts.slice(0, 4).map((post) => (
					<HeroTile
						href={`/blog/${post.id}/`}
						title={post.data.title}
						description={post.data.description}
						longDescription={post.data.longDescription}
						heroImage={post.data.heroImage}
						heroImageAlt={post.data.heroImageAlt}
						date={post.data.pubDate}
					/>
				))
			}
		</ul>
		<a href="/blog/">See all &rarr;</a>
	</section>

	<section>
		<h2>Scrapbooking With Code</h2>
		<ul class="grid grid-titled">
			{
				labs.slice(0, 4).map((lab) => (
					<HeroTile
						href={lab.data.url ?? `/lab/${lab.data.slug}/`}
						external={Boolean(lab.data.url)}
						title={lab.data.title}
						description={lab.data.description}
						longDescription={lab.data.longDescription}
						heroImage={lab.data.heroImage}
						heroImageAlt={lab.data.heroImageAlt}
						titleAbove
					/>
				))
			}
		</ul>
		<a href="/lab/">See all &rarr;</a>
	</section>
</BaseLayout>

<style>
	.hero {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
	}
	.grid {
		list-style: none;
		padding: 0;
		margin-top: 2rem;
		display: grid;
		gap: 3rem 1rem;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
	}
	.grid-titled {
		margin-top: 4rem;
	}
</style>
