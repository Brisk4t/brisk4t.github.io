---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const labs = (await getCollection('labs', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Home">
	<section>
		<div class="hero">
			<img class="profile-pic" src="https://github.com/Brisk4t.png?size=200" alt="Brisk4t" loading="lazy" />
			<h1>Brisk4t</h1>
		</div>
		<p>Portfolio, blog, and a scrapbook of UI experiments &mdash; each one built as its own self-contained page.</p>
	</section>

	<section>
		<h2>Latest lab pieces</h2>
		<ul class="grid">
			{
				labs.slice(0, 4).map((lab) => (
					<li>
						<a href={`/lab/${lab.data.slug}/`}>{lab.data.title}</a>
						<p>{lab.data.description}</p>
					</li>
				))
			}
		</ul>
		<a href="/lab/">See all &rarr;</a>
	</section>

	<section>
		<h2>Latest posts</h2>
		<ul class="grid">
			{
				posts.slice(0, 4).map((post) => (
					<li class="post-card">
						<a href={`/blog/${post.id}/`}>
							<div class="body">
								<span class="title">{post.data.title}</span>
								<p>{post.data.description}</p>
							</div>
							{post.data.heroImage && (
								<img class="thumb" src={post.data.heroImage} alt={post.data.heroImageAlt ?? ''} loading="lazy" />
							)}
						</a>
					</li>
				))
			}
		</ul>
		<a href="/blog/">See all &rarr;</a>
	</section>
</BaseLayout>

<style>
	.hero {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.profile-pic {
		display: block;
		width: 4rem;
		height: 4rem;
		border-radius: 50%;
		object-fit: cover;
	}
	.grid {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
	}
	.grid li {
		border: 1px solid color-mix(in srgb, currentColor 15%, transparent);
		border-radius: 0.5rem;
		padding: 1rem;
	}
	.grid li.post-card {
		padding: 0;
		overflow: hidden;
	}
	.post-card > a {
		display: flex;
		align-items: stretch;
		gap: 1rem;
		height: 100%;
		color: inherit;
		text-decoration: none;
	}
	.post-card .body {
		flex: 1;
		min-width: 0;
		padding: 1rem 0 1rem 1.25rem;
	}
	.post-card .title {
		font-weight: 600;
	}
	.post-card > a:hover .title {
		text-decoration: underline;
	}
	.post-card .thumb {
		width: 10rem;
		flex-shrink: 0;
		object-fit: cover;
	}
</style>
