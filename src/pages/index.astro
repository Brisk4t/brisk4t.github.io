---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroTile from '../components/HeroTile.astro';
import AsciiText from '../components/AsciiText.astro';
import MagnetLines from '../components/MagnetLines.astro';
import { getCollection } from 'astro:content';

const labs = (await getCollection('labs', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Home">
	<div class="page-bg" aria-hidden="true">
		<MagnetLines rows={10} columns={18} containerSize="100%" lineWidth="0.25vmin" lineHeight="3vmin" />
	</div>
	<section>
		<div class="hero">
			<AsciiText text="Brisk4t" enableWaves={false} />
			<h3>All my crimes.</h3>
		</div>
	</section>

	<section>
		<h2>Dev Blog</h2>
		<ul class="grid">
			{
				posts.slice(0, 4).map((post) => (
					<HeroTile
						href={`/blog/${post.id}/`}
						title={post.data.title}
						description={post.data.description}
						longDescription={post.data.longDescription}
						heroImage={post.data.heroImage}
						heroImageAlt={post.data.heroImageAlt}
						date={post.data.pubDate}
					/>
				))
			}
		</ul>
		<a href="/blog/">See all &rarr;</a>
	</section>

	<section>
		<h2>Scrapbooking With Code</h2>
		<ul class="grid grid-titled">
			{
				labs.slice(0, 4).map((lab) => (
					<HeroTile
						href={lab.data.url ?? `/lab/${lab.data.slug}/`}
						external={Boolean(lab.data.url)}
						title={lab.data.title}
						description={lab.data.description}
						longDescription={lab.data.longDescription}
						heroImage={lab.data.heroImage}
						heroImageAlt={lab.data.heroImageAlt}
						titleAbove
					/>
				))
			}
		</ul>
		<a href="/lab/">See all &rarr;</a>
	</section>
</BaseLayout>

<style>
	.page-bg {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		overflow: hidden;
		opacity: 0.16;
		pointer-events: none;
		z-index: -1;
	}
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.25rem;
		text-align: center;
	}
	.hero h3 {
		margin: 0;
	}
	.grid {
		list-style: none;
		padding: 0;
		margin-top: 2rem;
		display: grid;
		gap: 3rem 1rem;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
	}
	.grid-titled {
		margin-top: 4rem;
	}
</style>
