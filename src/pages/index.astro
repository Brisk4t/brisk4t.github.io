---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroTile from '../components/HeroTile.astro';
import { getCollection } from 'astro:content';

const labs = (await getCollection('labs', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Home">
	<section>
		<div class="hero">
			<img class="profile-pic" src="https://github.com/Brisk4t.png?size=200" alt="Brisk4t" loading="lazy" />
			<h1>Brisk4t</h1>
		</div>
		<h2>Portfolio, blog, and a scrapbook of UI experiments - each one built as its own self-contained page.</h2>
	</section>

	<section>
		<h2>Dev Blog</h2>
		<ul class="grid">
			{
				posts.slice(0, 4).map((post) => (
					<HeroTile
						href={`/blog/${post.id}/`}
						title={post.data.title}
						description={post.data.description}
						longDescription={post.data.longDescription}
						heroImage={post.data.heroImage}
						heroImageAlt={post.data.heroImageAlt}
						date={post.data.pubDate}
					/>
				))
			}
		</ul>
		<a href="/blog/">See all &rarr;</a>
	</section>

	<section>
		<h2>Scrapbooking With Code</h2>
		<ul class="grid">
			{
				labs.slice(0, 4).map((lab) => (
					<HeroTile
						href={lab.data.url ?? `/lab/${lab.data.slug}/`}
						external={Boolean(lab.data.url)}
						title={lab.data.title}
						description={lab.data.description}
						longDescription={lab.data.longDescription}
						heroImage={lab.data.heroImage}
						heroImageAlt={lab.data.heroImageAlt}
					/>
				))
			}
		</ul>
		<a href="/lab/">See all &rarr;</a>
	</section>
</BaseLayout>

<style>
	.hero {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.profile-pic {
		display: block;
		width: 4rem;
		height: 4rem;
		border-radius: 50%;
		object-fit: cover;
	}
	.grid {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
	}
</style>
