---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroTile from '../components/HeroTile.astro';
import AsciiText from '../components/AsciiText.astro';
import MagnetLines from '../components/MagnetLines.astro';
import InfiniteSpiral from '../components/InfiniteSpiral.astro';
import { getCollection } from 'astro:content';

const labs = (await getCollection('labs', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Home">
	<div class="page-bg" aria-hidden="true">
		<MagnetLines rows={10} columns={18} containerSize="100%" lineWidth="0.25vmin" lineHeight="3vmin" />
	</div>
	<section>
		<div class="hero">
			<AsciiText text="Brisk4t" enableWaves={false} />
			<h3>All my crimes.</h3>
		</div>
	</section>

	<div class="split">
		<section class="col-blog">
			<div class="section-heading">
				<h1>Dev Blog</h1>
				<a href="/blog/">See all &rarr;</a>
			</div>
			<ul class="grid">
				{
					posts.slice(0, 4).map((post) => (
						<HeroTile
							href={`/blog/${post.id}/`}
							title={post.data.title}
							description={post.data.description}
							longDescription={post.data.longDescription}
							heroImage={post.data.heroImage}
							heroImageAlt={post.data.heroImageAlt}
							date={post.data.pubDate}
						/>
					))
				}
			</ul>
		</section>

		<section class="col-scrapbook">
			<div class="section-heading">
				<h1>Scrapbooking With Code</h1>
				<a href="/lab/">See all &rarr;</a>
			</div>
			{(() => {
				const spiralItems = labs
					.filter((lab) => lab.data.heroImage)
					.map((lab) => ({
						src: lab.data.heroImage!,
						alt: lab.data.heroImageAlt,
						href: lab.data.url ?? `/lab/${lab.data.slug}/`,
						target: lab.data.url ? '_blank' : undefined,
						label: lab.data.title,
						title: lab.data.title,
						description: lab.data.description,
						longDescription: lab.data.longDescription,
					}));
				return (
					<InfiniteSpiral
						items={spiralItems}
						animationMode="all"
						pauseOnHover={true}
						grayscale={0}
						cardsPerTurn={spiralItems.length}
						speed={0.18}
						cardWidth={170}
						cardHeight={170}
						radius={190}
						verticalSpacing={110}
					/>
				);
			})()}
		</section>
	</div>
</BaseLayout>

<style>
	:global(main) {
		max-width: none;
		margin: 0;
		padding: 2rem 3rem 3rem;
	}
	.page-bg {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		overflow: hidden;
		opacity: 0.16;
		pointer-events: none;
		z-index: -1;
	}
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.25rem;
		text-align: center;
	}
	.hero h3 {
		margin: 0;
	}
	.split {
		display: grid;
		grid-template-columns: 5fr 5fr;
		gap: 0 2.5rem;
		align-items: start;
		margin-top: 2rem;
	}
	.section-heading {
		display: flex;
		align-items: baseline;
		justify-content: flex-start;
		gap: 1rem;
	}
	.col-blog .section-heading {
		justify-content: flex-end;
	}
	.section-heading h1,
	.section-heading h2 {
		margin: 0;
	}
	.col-scrapbook :global(.infinite-spiral) {
		height: 46rem;
	}
	@media (max-width: 800px) {
		.split {
			grid-template-columns: 1fr;
			gap: 3rem 0;
		}
		.col-blog .section-heading {
			justify-content: flex-start;
		}
	}
	.grid {
		list-style: none;
		padding: 0;
		margin-top: 2rem;
		display: grid;
		justify-content: end;
		gap: 4rem 2.5rem;
		grid-template-columns: repeat(auto-fit, minmax(200px, 260px));
	}
</style>
