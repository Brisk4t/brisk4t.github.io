---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const labs = (await getCollection('labs', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Lab" description="A scrapbook of self-contained UI experiments.">
	<h1>Lab</h1>
	<p>Every piece here is a self-contained page &mdash; its own styling, sometimes its own framework. Adding a new one is a folder plus a registry entry; nothing here has to be touched.</p>

	<ul class="cards">
		{
			labs.map((lab) => (
				<li style={`--accent: ${lab.data.accent}`}>
					<a href={`/lab/${lab.data.slug}/`}>
						{lab.data.heroImage && (
							<img class="thumb" src={lab.data.heroImage} alt={lab.data.heroImageAlt ?? ''} loading="lazy" />
						)}
						<div class="overlay" />
						<div class="body">
							<h2>{lab.data.title}</h2>
							<p>{lab.data.description}</p>
							<ul class="tags">
								{lab.data.tags.map((tag) => (
									<li>{tag}</li>
								))}
							</ul>
						</div>
					</a>
				</li>
			))
		}
	</ul>
</BaseLayout>

<style>
	.cards {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
	}
	.cards li {
		border: 1px solid color-mix(in srgb, currentColor 15%, transparent);
		border-radius: 0.75rem;
		overflow: hidden;
		background: var(--accent, #6366f1);
	}
	.cards a {
		position: relative;
		display: block;
		min-height: 12rem;
		padding: 1rem;
		color: #fff;
		text-decoration: none;
	}
	.thumb {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.5);
	}
	.body {
		position: relative;
	}
	.cards h2 {
		margin: 0;
		font-size: 1.1rem;
	}
	.cards a:hover h2 {
		text-decoration: underline;
	}
	.tags {
		display: flex;
		gap: 0.4rem;
		list-style: none;
		padding: 0;
		margin: 0.75rem 0 0;
		font-size: 0.75rem;
		opacity: 0.85;
	}
	.tags li {
		border: 1px solid currentColor;
		border-radius: 999px;
		padding: 0.1rem 0.5rem;
	}
</style>
