---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Masonry from '../../components/shared/Masonry.astro';
import FlipTitle from '../../components/effects/FlipTitle.astro';
import { getCollection } from 'astro:content';

const labs = (await getCollection('labs', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const items = labs.map((lab) => ({
	src: lab.data.heroImage,
	alt: lab.data.heroImageAlt,
	accent: lab.data.accent,
	href: lab.data.url ?? `/lab/${lab.data.slug}/`,
	target: lab.data.url ? '_blank' : undefined,
	label: lab.data.title,
	title: lab.data.title,
	description: lab.data.description,
	longDescription: lab.data.longDescription,
	tags: lab.data.tags,
}));
---

<BaseLayout title="Lab" description="A scrapbook of self-contained UI experiments.">
	<h1 class="page-heading">
		<FlipTitle text="Scrapbook" hoverText="Lab" randomizeStartColors />
	</h1>
	<p class="intro">Every piece here is a self-contained page &mdash; its own styling, sometimes its own framework. Feel free to look around, don't be surprised if you get teleported to a different world (not always a better one :3)</p>

	<Masonry items={items} />
</BaseLayout>

<style>
	/* Full-width like the home page, instead of the layout's 960px column. */
	:global(main) {
		max-width: none;
		margin: 0;
		padding: 2rem 3rem 3rem;
	}
	.page-heading {
		margin: 0 0 1rem;
	}
	.intro {
		font-size: 1.25rem;
		line-height: 1.5;
	}
	:global(.masonry) {
		margin-top: 2rem;
	}
</style>
