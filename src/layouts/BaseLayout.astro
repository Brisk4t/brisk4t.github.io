---
import SiteNav from '../components/site/SiteNav.astro';
import DigitalClock from '../components/site/DigitalClock.astro';
import SiteTerminal from '../components/site/SiteTerminal.astro';
import MagnetLines from '../components/effects/MagnetLines.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Brisk4t — portfolio, blog, and UI scrapbook.' } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<!-- Applied before any stylesheet loads, so the first paint (or a page whose CSS/MagnetLines fails to load)
		     gets the same background that normally sits behind MagnetLines instead of the browser's light default. -->
		<meta name="color-scheme" content="light dark" />
		<style is:inline>html { background: Canvas; }</style>
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · brisk4t</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Doto:wght@100..900&display=swap" rel="stylesheet" />
	</head>
	<body>
		<div class="page-bg" aria-hidden="true">
			<MagnetLines rows={10} columns={18} containerSize="100%" lineWidth="0.25vmin" lineHeight="3vmin" />
		</div>
		<SiteNav />
		<div class="clock-fixed">
			<DigitalClock />
		</div>
		<main>
			<slot />
		</main>
		<footer>
			<p>&copy; {new Date().getFullYear()} Brisk4t</p>
		</footer>
		<SiteTerminal />
		<script>
			// GitHub repo cards (src/lib/remark-github-card.mjs) are rendered at build time, so their
			// star/fork counts go stale between deploys. Refresh them from the GitHub API on load;
			// on any failure (offline, rate limit) the build-time numbers just stay.
			const format = new Intl.NumberFormat('en', { notation: 'compact' });
			const cards = document.querySelectorAll<HTMLElement>('[data-gh-repo]');
			const repos = new Set(Array.from(cards, (card) => card.dataset.ghRepo!));
			for (const repo of repos) {
				fetch(`https://api.github.com/repos/${repo}`, { headers: { Accept: 'application/vnd.github+json' } })
					.then((res) => (res.ok ? res.json() : null))
					.then((data) => {
						if (!data) return;
						for (const card of cards) {
							if (card.dataset.ghRepo !== repo) continue;
							const stars = card.querySelector('[data-gh-stars]');
							const forks = card.querySelector('[data-gh-forks]');
							if (stars) stars.textContent = format.format(data.stargazers_count);
							if (forks) forks.textContent = format.format(data.forks_count);
						}
					})
					.catch(() => {});
			}
		</script>
	</body>
</html>

<style is:global>
	@font-face {
		font-family: 'DSEG7 Classic';
		src:
			url('/fonts/DSEG7-Classic/DSEG7Classic-Regular.woff2') format('woff2');
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}
	@font-face {
		font-family: 'DSEG7 Classic';
		src:
			url('/fonts/DSEG7-Classic/DSEG7Classic-Bold.woff2') format('woff2');
		font-weight: 700;
		font-style: normal;
		font-display: swap;
	}
	:root {
		color-scheme: light dark;
		/* Height of the SiteTerminal's collapsed titlebar, which stays fixed to the
		   viewport bottom — the footer needs this much clearance so the terminal
		   never occludes it. */
		--terminal-bar-height: 2.1rem;
	}
	* {
		box-sizing: border-box;
	}
	img {
		max-width: 100%;
		height: auto;
	}
	body {
		margin: 0;
		min-height: 100dvh;
		display: flex;
		flex-direction: column;
		font-family: system-ui, sans-serif;
		line-height: 1.5;
		padding-left: 48px;
	}
	main {
		flex: 1 0 auto;
		/* min-width: 0 stops wide content (long code lines, tables) from stretching
		   main past the viewport — it scrolls inside its own box instead. */
		width: 100%;
		min-width: 0;
		max-width: 960px;
		margin: 0 auto;
		padding: 1rem 1.5rem 1.5rem;
		overflow-wrap: break-word;
	}
	main article pre {
		max-width: 100%;
		overflow-x: auto;
	}
	main article pre.astro-code {
		padding: 0.9rem 1.1rem;
		border-radius: 0px;
		font-size: 0.875rem;
		line-height: 1.55;
	}
	/* ```lang title="file" blocks (see src/lib/shiki-code-title.mjs) */
	main article figure.code-block {
		margin: 1em 0;
		border-radius: 0px;
		overflow: hidden;
	}
	main article figure.code-block pre.astro-code {
		margin: 0;
		border-radius: 0;
	}
	main article .code-title {
		/* Slightly lifted from Shiki's default github-dark background (#24292e) so it reads as a tab bar. */
		background: #1c2024;
		color: #777e86;
		padding: 0.4rem 1.1rem;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.8rem;
	}
	/* Standalone GitHub repo links (see src/lib/remark-github-card.mjs) */
	main article .gh-card {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin: 1.25em 0;
		padding: 1rem;
		background: light-dark(#f6f8fa, #151b23);
		border: 1px solid light-dark(#d0d7de, #30363d);
		border-radius: 6px;
		color: light-dark(#59636e, #9198a1);
		font-size: 0.875rem;
		text-decoration: none;
		transition: border-color 0.15s;
	}
	main article .gh-card:hover {
		border-color: light-dark(#8c959f, #6e7681);
	}
	main article .gh-card svg {
		flex-shrink: 0;
	}
	main article .gh-card-title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: light-dark(#0969da, #4493f8);
		font-size: 1rem;
	}
	main article .gh-card-logo {
		display: flex;
		margin-left: auto;
		color: light-dark(#1f2328, #f0f6fc);
	}
	main article .gh-card-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		font-size: 0.75rem;
	}
	main article .gh-card-meta > span {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
	}
	main article .gh-card-lang {
		width: 0.75rem;
		height: 0.75rem;
		border-radius: 50%;
	}
	main article table {
		display: block;
		max-width: 100%;
		overflow-x: auto;
	}
	@media (max-width: 640px) {
		body {
			padding-left: 0;
			padding-bottom: calc(48px + env(safe-area-inset-bottom) + var(--terminal-bar-height));
		}
	}
	footer {
		flex-shrink: 0;
		text-align: center;
		padding: 1.25rem;
		padding-bottom: calc(1.25rem + var(--terminal-bar-height));
		opacity: 0.6;
		font-size: 0.85rem;
	}
	footer p {
		margin: 0;
	}
</style>

<style>
	.page-bg {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		overflow: hidden;
		opacity: 0.16;
		pointer-events: none;
		z-index: -1;
	}
	.clock-fixed {
		position: fixed;
		top: 1rem;
		right: 0.5rem;
		z-index: -1;
	}
	@media (max-width: 640px) {
		.clock-fixed {
			left: 0;
			right: 0;
			top: 1rem;
		}
	}
</style>
