---
import SiteNav from '../components/SiteNav.astro';
import DigitalClock from '../components/DigitalClock.astro';
import SiteTerminal from '../components/SiteTerminal.astro';
import MagnetLines from '../components/MagnetLines.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Brisk4t — portfolio, blog, and UI scrapbook.' } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · brisk4t</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Doto:wght@100..900&display=swap" rel="stylesheet" />
	</head>
	<body>
		<div class="page-bg" aria-hidden="true">
			<MagnetLines rows={10} columns={18} containerSize="100%" lineWidth="0.25vmin" lineHeight="3vmin" />
		</div>
		<SiteNav />
		<div class="clock-fixed">
			<DigitalClock />
		</div>
		<main>
			<slot />
		</main>
		<footer>
			<p>&copy; {new Date().getFullYear()} Brisk4t</p>
		</footer>
		<SiteTerminal />
	</body>
</html>

<style is:global>
	@font-face {
		font-family: 'DSEG7 Classic';
		src:
			url('/fonts/DSEG7-Classic/DSEG7Classic-Regular.woff2') format('woff2');
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}
	@font-face {
		font-family: 'DSEG7 Classic';
		src:
			url('/fonts/DSEG7-Classic/DSEG7Classic-Bold.woff2') format('woff2');
		font-weight: 700;
		font-style: normal;
		font-display: swap;
	}
	:root {
		color-scheme: light dark;
		/* Height of the SiteTerminal's collapsed titlebar, which stays fixed to the
		   viewport bottom — the footer needs this much clearance so the terminal
		   never occludes it. */
		--terminal-bar-height: 2.1rem;
	}
	* {
		box-sizing: border-box;
	}
	img {
		max-width: 100%;
		height: auto;
	}
	body {
		margin: 0;
		min-height: 100dvh;
		display: flex;
		flex-direction: column;
		font-family: system-ui, sans-serif;
		line-height: 1.5;
		padding-left: 48px;
	}
	main {
		flex: 1 0 auto;
		max-width: 960px;
		margin: 0 auto;
		padding: 1rem 1.5rem 1.5rem;
	}
	@media (max-width: 640px) {
		body {
			padding-left: 0;
			padding-bottom: calc(48px + env(safe-area-inset-bottom) + var(--terminal-bar-height));
		}
	}
	footer {
		flex-shrink: 0;
		text-align: center;
		padding: 1.25rem;
		padding-bottom: calc(1.25rem + var(--terminal-bar-height));
		opacity: 0.6;
		font-size: 0.85rem;
	}
	footer p {
		margin: 0;
	}
</style>

<style>
	.page-bg {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		overflow: hidden;
		opacity: 0.16;
		pointer-events: none;
		z-index: -1;
	}
	.clock-fixed {
		position: fixed;
		top: 4.5rem;
		right: 0.5rem;
		z-index: -1;
	}
	@media (max-width: 640px) {
		.clock-fixed {
			left: 0;
			right: 0;
			top: 4rem;
		}
	}
</style>
